PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/harness.db
RULES_PATH=./data/rules.json
MODEL_ID=z-ai/glm-5.3-flash
OPENROUTER_TOKEN=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AUTOPLAY_MAX_CONSECUTIVE_FAILURES=2
AUTOPLAY_RETRY_BASE_SECONDS=2
AUTOPLAY_MAX_CAPACITY_FAILURES=4
AUTOPLAY_CAPACITY_RETRY_BASE_SECONDS=15
OPENROUTER_PROVIDER_BLOCKLIST=together,gmicloud,alibaba,novita,makora,siliconflow

# Optional OpenTelemetry HTTP trace endpoint, for example Phoenix:
# http://localhost:6006/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=raven-harness

# Optional direct-OpenAI fallback when OPENROUTER_TOKEN is empty:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
